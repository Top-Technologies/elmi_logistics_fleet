<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Wizard Form View -->
    <record id="view_top_fleet_activity_report_wizard_form" model="ir.ui.view">
        <field name="name">top.fleet.activity.report.wizard.form</field>
        <field name="model">top.fleet.activity.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Fleet Activity &amp; Sub-Trips Report">
                <div class="alert alert-info" role="alert">
                    <strong>Fleet Activity &amp; Telematics Audit:</strong> Generate detailed reports covering where vehicles traveled, sub-trips and intermediate stops taken, point-to-point transit duration, and full fuel consumption from first dispatch to final return.
                </div>
                <group>
                    <group string="Reporting Period">
                        <field name="report_type" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filter Criteria">
                        <field name="trip_state"/>
                        <field name="vehicle_ids" widget="many2many_tags" placeholder="All vehicles..."/>
                        <field name="driver_ids" widget="many2many_tags" placeholder="All drivers..."/>
                        <field name="trip_ids" widget="many2many_tags" placeholder="Specific trips (optional)..."/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print Activity Report (PDF)" type="object" class="btn-primary" icon="fa-print"/>
                    <button name="action_view_trips" string="Analyze Trips &amp; Pivot" type="object" class="btn-secondary" icon="fa-bar-chart"/>
                    <button name="action_view_sub_trips" string="Analyze Sub-Trips &amp; Legs" type="object" class="btn-secondary" icon="fa-map-signs"/>
                    <button string="Cancel" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_top_fleet_activity_report_wizard" model="ir.actions.act_window">
        <field name="name">Fleet Activity &amp; Sub-Trips Report</field>
        <field name="res_model">top.fleet.activity.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 2. Sub-Trips & Waypoint Stops Views & Action -->
    <record id="view_top_fleet_trip_waypoint_list" model="ir.ui.view">
        <field name="name">top.fleet.trip.waypoint.list</field>
        <field name="model">top.fleet.trip.waypoint</field>
        <field name="arch" type="xml">
            <list string="Sub-Trips &amp; Intermediate Stops" decoration-success="state == 'completed'" decoration-warning="state == 'pending'" decoration-danger="state == 'cancelled'">
                <field name="sequence" widget="handle"/>
                <field name="trip_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="from_location_name"/>
                <field name="location_name" string="To Stop / Destination"/>
                <field name="stop_type" widget="badge"/>
                <field name="actual_arrival"/>
                <field name="actual_departure"/>
                <field name="travel_time_display" string="Travel Time"/>
                <field name="travel_time_hours" sum="Total Travel Hours" optional="show"/>
                <field name="dwell_time_display" string="Dwell Time" optional="show"/>
                <field name="time_spent_hours" sum="Total Dwell Hours" optional="show"/>
                <field name="odometer" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_top_fleet_trip_waypoint_pivot" model="ir.ui.view">
        <field name="name">top.fleet.trip.waypoint.pivot</field>
        <field name="model">top.fleet.trip.waypoint</field>
        <field name="arch" type="xml">
            <pivot string="Sub-Trips &amp; Stop Dwell Analysis">
                <field name="vehicle_id" type="row"/>
                <field name="trip_id" type="row"/>
                <field name="stop_type" type="col"/>
                <field name="travel_time_hours" type="measure"/>
                <field name="time_spent_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_top_fleet_trip_waypoint_search" model="ir.ui.view">
        <field name="name">top.fleet.trip.waypoint.search</field>
        <field name="model">top.fleet.trip.waypoint</field>
        <field name="arch" type="xml">
            <search string="Search Sub-Trips">
                <field name="trip_id"/>
                <field name="location_name"/>
                <field name="from_location_name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Completed Stops" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Pending Stops" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter string="Trip" name="group_by_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Driver" name="group_by_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Stop Purpose" name="group_by_type" context="{'group_by': 'stop_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_top_fleet_sub_trips_analysis" model="ir.actions.act_window">
        <field name="name">Sub-Trips &amp; Waypoints Analysis</field>
        <field name="res_model">top.fleet.trip.waypoint</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_top_fleet_trip_waypoint_search"/>
        <field name="context">{'search_default_group_by_trip': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sub-trips or waypoint records found.
            </p>
            <p>
                As trips are executed with intermediate waypoints, point-to-point travel duration and stop dwell times will appear here.
            </p>
        </field>
    </record>

    <!-- 3. Overall Trips & Legs Pivot Analysis Action -->
    <record id="action_top_fleet_trips_analysis" model="ir.actions.act_window">
        <field name="name">Trip &amp; Leg Activity Analysis</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_filter_completed': 1, 'search_default_group_by_vehicle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze fleet trip activity, distance, duration, sub-trips, and fuel consumption across all vehicles.
            </p>
        </field>
    </record>
</odoo>
