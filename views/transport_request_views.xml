<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_top_transport_request_list" model="ir.ui.view">
        <field name="name">top.transport.request.list</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <list string="Transport Requests" decoration-danger="priority == 'emergency'" decoration-muted="state in ('draft', 'cancelled')" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="fleet_order_type" widget="badge"
                       decoration-warning="fleet_order_type == 'heavy'"
                       decoration-info="fleet_order_type == 'light'"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin_location_id" optional="show"/>
                <field name="destination_location_id" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="destination" optional="hide"/>
                <field name="total_stops_count" string="Stops" optional="show"/>
                <field name="required_date"/>
                <field name="return_date"/>
                <field name="assigned_vehicle_id"/>
                <field name="assigned_driver_id"/>
                <field name="priority" widget="badge" 
                       decoration-danger="priority == 'emergency'" 
                       decoration-warning="priority == 'high'" 
                       decoration-info="priority == 'normal'" 
                       decoration-muted="priority == 'low'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('submitted', 'under_review')"
                       decoration-primary="state in ('approved', 'vehicle_search')"
                       decoration-warning="state in ('assigned', 'dispatched', 'in_transit')"
                       decoration-success="state in ('completed', 'reconciled', 'closed')"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_top_transport_request_form" model="ir.ui.view">
        <field name="name">top.transport.request.form</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transport Request">
                <header>
                    <!-- Workflow Action Buttons -->
                    <button name="action_submit" string="Submit Request" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    
                    <button name="action_review" string="Review" type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="elmi_logistics_fleet.group_fleet_supervisor,elmi_logistics_fleet.group_department_approver,elmi_logistics_fleet.group_fleet_officer,elmi_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="elmi_logistics_fleet.group_fleet_supervisor,elmi_logistics_fleet.group_department_approver,elmi_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="%(action_transport_request_reject_wizard)d" string="Reject" type="action" class="btn-danger"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="elmi_logistics_fleet.group_fleet_supervisor,elmi_logistics_fleet.group_department_approver,elmi_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_vehicle_search" string="Search Vehicle" type="object" class="btn-secondary"
                            invisible="state != 'approved'"
                            groups="elmi_logistics_fleet.group_fleet_supervisor,elmi_logistics_fleet.group_fleet_officer,elmi_logistics_fleet.group_fleet_manager"/>
                    
                    <!-- Vehicle Assignment Wizard Trigger (Sections 10, 11, 12) -->
                    <button name="action_open_assignment_wizard" string="Assign Vehicle and Driver" type="object" class="btn-primary"
                            invisible="state not in ('approved', 'vehicle_search') and (priority != 'emergency' or state in ('assigned', 'dispatched', 'in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled'))"
                            groups="elmi_logistics_fleet.group_fleet_supervisor,elmi_logistics_fleet.group_fleet_officer,elmi_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled')"/>
                    
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancelled')"/>

                    <!-- Status Bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,assigned,dispatched,in_transit,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trip" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="trip_count == 0">
                            <field name="trip_count" widget="statinfo" string="Trip"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="alert alert-warning" role="alert" invisible="not post_trip_review_required">
                        <strong>Emergency Fast-Track:</strong> This request was directly assigned. Post-trip review is required upon completion.
                    </div>

                    <!-- Modern Executive Header Hero Card -->
                    <div class="tr_header_card mb-3">
                        <div class="row align-items-center">
                            <!-- Left: Icon and Request No -->
                            <div class="col-md-3 d-flex align-items-center border-end">
                                <div class="tr_icon_circle me-3">
                                    <i class="fa fa-truck"/>
                                </div>
                                <div>
                                    <div class="tr_header_label">Transport Request No.</div>
                                    <div class="tr_header_val_bold">
                                        <field name="name" class="text-primary"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Mid-Left: Reference Work Order No -->
                            <div class="col-md-3 px-3 border-end">
                                <div class="tr_header_label">Reference Work Order No.</div>
                                <div class="mt-1">
                                    <field name="reference_work_order_no" class="tr_header_val_mono" placeholder="e.g. MDQ_260726_001" readonly="state != 'draft'"/>
                                </div>
                            </div>

                            <!-- Mid-Right: Priority Badge -->
                            <div class="col-md-2 px-3 border-end text-center">
                                <div class="tr_header_label">Priority</div>
                                <div class="mt-1">
                                    <field name="priority" widget="badge" 
                                           decoration-danger="priority in ('high', 'emergency')" 
                                           decoration-warning="priority == 'normal'" 
                                           decoration-info="priority == 'low'"/>
                                </div>
                            </div>

                            <!-- Right: Request Date and Icon -->
                            <div class="col-md-4 ps-3 d-flex align-items-center">
                                <i class="fa fa-calendar tr_date_icon me-3"/>
                                <div>
                                    <div class="tr_header_label">Request Date</div>
                                    <div class="fw-bold fs-6 text-dark">
                                        <field name="request_date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transport Request Information and Dates and Priority Side by Side Cards -->
                    <div class="row g-3 mb-3">
                        <!-- Card 1: Transport Request Information (Purple Header) -->
                        <div class="col-md-6">
                            <div class="tr_section_card">
                                <div class="tr_card_header_purple">
                                    <i class="fa fa-info-circle me-2 fs-5"/> Transport Request Information
                                </div>
                                <div class="tr_card_body">
                                    <group class="p-0 m-0">
                                        <field name="requester_id" widget="many2one_avatar_user" string="Requestor" readonly="state != 'draft'"/>
                                        <field name="employee_id" string="Requestor Employee" readonly="state != 'draft'"/>
                                        <field name="requester_position" string="Requestor Position" placeholder="e.g. PROJECT MANAGER" readonly="state != 'draft'"/>
                                        <field name="department_id" string="Department" readonly="state != 'draft'"/>
                                        <field name="request_type" widget="badge" readonly="state != 'draft'"/>
                                        <field name="request_origin" widget="badge" readonly="state != 'draft'"/>
                                        <field name="department_or_project" invisible="1"/>
                                        <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: Dates and Priority (Purple Header) -->
                        <div class="col-md-6">
                            <div class="tr_section_card">
                                <div class="tr_card_header_purple">
                                    <i class="fa fa-calendar-check-o me-2 fs-5"/> Dates and Priority
                                </div>
                                <div class="tr_card_body">
                                    <group class="p-0 m-0">
                                        <field name="required_date" string="Required Date" readonly="state != 'draft'"/>
                                        <field name="return_date" string="Return Date" readonly="state != 'draft'"/>
                                        <field name="fleet_order_type" widget="radio" options="{'horizontal': true}" string="Fleet Order Type" class="tr_radio_horizontal" readonly="state != 'draft'"/>
                                        <field name="priority" widget="priority" string="Priority Rating" readonly="state != 'draft'"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Origin and Destination Side by Side Cards (Light Green Header) -->
                    <div class="row g-3 mb-3">
                        <!-- Origin Card -->
                        <div class="col-md-6">
                            <div class="tr_section_card">
                                <div class="tr_card_header_light_green">
                                    <i class="fa fa-map-marker text-success me-2 fs-5"/> Origin
                                </div>
                                <div class="tr_card_body">
                                    <group class="p-0 m-0">
                                        <field name="origin_location_id" options="{'no_create_edit': False}" string="Origin Location" placeholder="Select Predefined Origin..." readonly="state != 'draft'"/>
                                        <field name="origin_description" string="Origin Description" placeholder="e.g. RONA SITE" readonly="state != 'draft'"/>
                                        <field name="origin_state" string="Origin State" placeholder="ADDIS ABABA" readonly="state != 'draft'"/>
                                        <field name="origin_city" string="Origin City" placeholder="ADDIS ABABA" readonly="state != 'draft'"/>
                                        <field name="origin_subcity" string="Origin K/Y / Sub-City" placeholder="e.g. KIRKOS" readonly="state != 'draft'"/>
                                        <field name="origin_woreda" string="Origin Woreda" placeholder="e.g. 04" readonly="state != 'draft'"/>
                                        <field name="origin" invisible="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>

                        <!-- Destination Card -->
                        <div class="col-md-6">
                            <div class="tr_section_card">
                                <div class="tr_card_header_light_green">
                                    <i class="fa fa-flag text-success me-2 fs-5"/> Destination
                                </div>
                                <div class="tr_card_body">
                                    <group class="p-0 m-0">
                                        <field name="destination_location_id" options="{'no_create_edit': False}" string="Destination Location" placeholder="Select Predefined Destination..." readonly="state != 'draft'"/>
                                        <field name="destination_description" string="Destination Description" placeholder="e.g. CAVA" readonly="state != 'draft'"/>
                                        <field name="destination_state" string="Destination State" placeholder="ADDIS ABABA" readonly="state != 'draft'"/>
                                        <field name="destination_city" string="Destination City" placeholder="ADDIS ABABA" readonly="state != 'draft'"/>
                                        <field name="destination_subcity" string="Destination Kebele / Sub-City" placeholder="e.g. KOLFE KERANEO" readonly="state != 'draft'"/>
                                        <field name="destination_woreda" string="Destination Woreda" placeholder="e.g. 02" readonly="state != 'draft'"/>
                                        <field name="destination" invisible="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Auto-Calculated Distance Bar -->
                    <div class="alert alert-info py-2 d-flex justify-content-between align-items-center mb-3" invisible="not estimated_distance or estimated_distance == 0">
                        <div>
                            <strong><i class="fa fa-road me-1"/> Route Distance:</strong>
                            <span class="fs-6 fw-bold ms-2 text-primary"><field name="estimated_distance"/> km</span>
                            <span class="ms-3 text-muted">(Estimated Duration: <strong><field name="estimated_duration"/> Hours</strong>)</span>
                            <span class="ms-3 badge text-bg-warning" invisible="enroute_distance_added == 0">
                                En-Route Added: +<field name="enroute_distance_added"/> km (Total Revised: <field name="total_revised_distance"/> km)
                            </span>
                        </div>
                        <div class="small text-muted">
                            <i class="fa fa-check-circle text-success me-1"/> Computed from Route and Stop Coordinates
                        </div>
                    </div>

                    <notebook>
                        <page name="goods_transport" string="Type of Goods to be Transported">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="tr_section_card mb-3">
                                        <div class="tr_card_header_sub">
                                            <i class="fa fa-truck me-2 text-primary"/> <strong>Machinery / Vehicle</strong>
                                        </div>
                                        <div class="p-2">
                                            <field name="machinery_line_ids" readonly="state in ('completed', 'closed', 'cancelled')">
                                                <list editable="bottom">
                                                    <field name="line_no" string="No."/>
                                                    <field name="vehicle_id" string="Fleet Asset" optional="show"/>
                                                    <field name="description" string="Machine/Vehicle Type" placeholder="e.g. Excavator CAT 320"/>
                                                    <field name="plate_no" string="Plate No." placeholder="e.g. 654321"/>
                                                    <field name="reason" string="Reason" placeholder="e.g. Mobilization"/>
                                                </list>
                                            </field>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="tr_section_card mb-3">
                                        <div class="tr_card_header_sub">
                                            <i class="fa fa-cubes me-2 text-primary"/> <strong>Goods</strong>
                                        </div>
                                        <div class="p-2">
                                            <field name="goods_line_ids" readonly="state in ('completed', 'closed', 'cancelled')">
                                                <list editable="bottom">
                                                    <field name="line_no" string="No."/>
                                                    <field name="product_id" string="Product Item" optional="show"/>
                                                    <field name="description" string="Description" placeholder="e.g. Innocent Pipe"/>
                                                    <field name="unit" string="Unit" placeholder="e.g. 4m PC, Pc, m2"/>
                                                    <field name="quantity" string="Quantity"/>
                                                </list>
                                            </field>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page name="passenger_manifest" string="Passenger Travel Manifest" invisible="request_type != 'passenger'">
                            <field name="passenger_line_ids" readonly="state in ('completed', 'closed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="employee_id"/>
                                    <field name="passenger_name"/>
                                    <field name="position"/>
                                    <field name="department_id"/>
                                    <field name="travel_date"/>
                                    <field name="return_date"/>
                                    <field name="duration_days"/>
                                    <field name="requires_vehicle_at_destination" widget="boolean_toggle"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page name="schedule_requirements" string="Specifications and Requirements">
                            <group>
                                <group string="Trip Specifications">
                                    <field name="trip_type_id" readonly="state != 'draft'"/>
                                    <field name="passenger_count" readonly="state != 'draft'"/>
                                    <field name="vehicle_type_id" placeholder="e.g. Pickup, Sedan, Truck" readonly="state != 'draft'"/>
                                </group>
                                <group string="Driver and Cargo Flags">
                                    <field name="driver_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                    <field name="cargo_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                    <field name="cargo_description" invisible="not cargo_required" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <page name="stops_page" string="Stops and Multi-Drop Waypoints">
                            <div class="alert alert-info py-2 mb-2 d-flex justify-content-between align-items-center" role="status">
                                <div>
                                    <i class="fa fa-map-signs me-1"/> 
                                    <strong>Multi-Stop Flexibility:</strong> Add intermediate pickups, dropoffs, or waypoints. Stops can be cancelled or marked visited individually.
                                </div>
                                <div class="text-end">
                                    <span class="badge text-bg-primary me-1"><field name="total_stops_count"/> Planned</span>
                                    <span class="badge text-bg-success me-1"><field name="completed_stops_count"/> Visited</span>
                                    <span class="badge text-bg-danger"><field name="cancelled_stops_count"/> Cancelled</span>
                                </div>
                            </div>
                            <field name="stop_ids" readonly="state in ('completed', 'reconciled', 'closed', 'cancelled')">
                                <list editable="bottom" decoration-muted="state == 'pending'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="location_id" options="{'no_create_edit': False}" placeholder="Predefined Location..."/>
                                    <field name="location_name" placeholder="Stop / Destination Name"/>
                                    <field name="stop_type" widget="badge"/>
                                    <field name="cargo_or_passenger_notes" placeholder="Pick up / drop off details..."/>
                                    <field name="estimated_arrival"/>
                                    <field name="actual_arrival"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'pending'"
                                           decoration-success="state == 'completed'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <field name="notes" optional="show"/>
                                    <button name="action_mark_completed" string="Mark Visited" type="object" icon="fa-check text-success" invisible="state == 'completed'"/>
                                    <button name="action_cancel_stop" string="Cancel Stop" type="object" icon="fa-times text-danger" invisible="state in ('completed', 'cancelled')"/>
                                </list>
                            </field>
                        </page>

                        <page name="purpose_page" string="Purpose and Description">
                            <field name="purpose" placeholder="Provide a detailed explanation of the travel or transport purpose..." readonly="state != 'draft'"/>
                        </page>

                        <page name="allocation_page" string="Allocation and Fleet Audit" invisible="state in ('draft', 'submitted', 'under_review')">
                            <group>
                                <group string="Assigned Vehicle and Maintenance Status">
                                    <field name="assigned_vehicle_id"/>
                                    <field name="vehicle_last_service_date"/>
                                    <field name="vehicle_next_service_date"/>
                                    <field name="vehicle_service_status" widget="badge"
                                           decoration-danger="vehicle_service_status == 'due'"
                                           decoration-success="vehicle_service_status == 'ok'"/>
                                    <field name="vehicle_is_service_due" widget="boolean_toggle" invisible="not vehicle_is_service_due"/>
                                </group>
                                <group string="Assigned Driver and License Compliance">
                                    <field name="assigned_driver_id"/>
                                    <field name="driver_license_expiry_date"/>
                                    <field name="driver_license_compliance" widget="badge"
                                           decoration-danger="driver_is_license_expired"
                                           decoration-success="not driver_is_license_expired"/>
                                </group>
                            </group>
                            <group string="Execution Metrics and Approval Audit">
                                <group string="Trip Performance">
                                    <field name="trip_id"/>
                                    <field name="trip_actual_distance" string="Actual Distance (km)"/>
                                    <field name="trip_duration_display" string="Total Time Taken"/>
                                    <field name="total_stops_count" string="Stops Total"/>
                                    <field name="completed_stops_count" string="Stops Visited"/>
                                </group>
                                <group string="Approval Audit">
                                    <field name="reviewed_by_id"/>
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                    <field name="post_trip_review_required" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <div class="alert alert-danger mt-3" role="alert" invisible="state != 'rejected'">
                                <strong>Rejection Reason:</strong>
                                <p><field name="rejection_reason" readonly="1"/></p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_top_transport_request_kanban" model="ir.ui.view">
        <field name="name">top.transport.request.kanban</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title text-primary">
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/> <field name="requester_id"/>
                                <span t-if="record.department_id.value"> (<field name="department_id"/>)</span>
                            </div>
                            <div class="mb-1 small">
                                <i class="fa fa-map-marker text-danger me-1"/> 
                                <field name="origin"/> ➔ <field name="destination"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                <span class="small text-muted">
                                    <i class="fa fa-calendar me-1"/> <field name="required_date"/>
                                </span>
                                <field name="trip_type_id" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_top_transport_request_calendar" model="ir.ui.view">
        <field name="name">top.transport.request.calendar</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <calendar string="Transport Requests" date_start="required_date" date_stop="return_date" color="department_id" mode="month">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_top_transport_request_search" model="ir.ui.view">
        <field name="name">top.transport.request.search</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <search string="Search Transport Requests">
                <field name="name" string="Request Number or Origin/Destination" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('origin', 'ilike', self), ('destination', 'ilike', self)]"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                
                <separator/>
                <filter string="Goods Transport (TR_)" name="filter_tr" domain="[('request_type', '=', 'transport')]"/>
                <filter string="Machinery Deploy (MR_)" name="filter_mr" domain="[('request_type', '=', 'machinery')]"/>
                <filter string="Passenger Travel (PR_)" name="filter_pr" domain="[('request_type', '=', 'passenger')]"/>
                <separator/>
                <filter string="Offline Logged (RC_)" name="filter_rc" domain="[('request_origin', '=', 'rc')]"/>
                <filter string="Online Requisition (OR_)" name="filter_or" domain="[('request_origin', '=', 'or')]"/>
                <separator/>
                <filter string="My Requests" name="filter_my_requests" domain="[('requester_id', '=', uid)]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', 'in', ['submitted', 'under_review'])]"/>
                <filter string="Approved / Ready for Assignment" name="filter_approved" domain="[('state', 'in', ['approved', 'vehicle_search'])]"/>
                <filter string="Active Trips" name="filter_active_trips" domain="[('state', 'in', ['assigned', 'dispatched', 'in_transit'])]"/>
                <filter string="Completed and Closed" name="filter_closed" domain="[('state', 'in', ['completed', 'reconciled', 'closed'])]"/>
                
                <separator/>
                <filter string="Light Fleet Orders" name="filter_light_fleet" domain="[('fleet_order_type', '=', 'light')]"/>
                <filter string="Heavy Fleet Orders" name="filter_heavy_fleet" domain="[('fleet_order_type', '=', 'heavy')]"/>
                <filter string="Emergency Priority" name="filter_emergency" domain="[('priority', '=', 'emergency')]"/>
                <filter string="High Priority" name="filter_high" domain="[('priority', 'in', ['high', 'emergency'])]"/>
                
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Fleet Order Type" name="group_by_fleet_order_type" context="{'group_by': 'fleet_order_type'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_by_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Trip Type" name="group_by_trip_type" context="{'group_by': 'trip_type_id'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Required Month" name="group_by_date" context="{'group_by': 'required_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Window Action -->
    <record id="action_top_transport_request_all" model="ir.actions.act_window">
        <field name="name">Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_top_transport_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first transport request!
            </p>
            <p>
                Submit requests for company vehicles, drivers, passenger transport, field missions, cargo movement, or emergency transport.
            </p>
        </field>
    </record>

    <!-- Filtered Action: My Requests -->
    <record id="action_top_transport_request_my" model="ir.actions.act_window">
        <field name="name">My Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid}</field>
    </record>

    <!-- Filtered Action: To Approve -->
    <record id="action_top_transport_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['submitted', 'under_review'])]</field>
    </record>

    <!-- Filtered Action: Allocation / Assignment -->
    <record id="action_top_transport_request_allocation" model="ir.actions.act_window">
        <field name="name">Requests for Vehicle Assignment</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['approved', 'vehicle_search'])]</field>
    </record>
</odoo>
