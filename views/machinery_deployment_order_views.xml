<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MDO Form View -->
    <record id="view_top_machinery_deployment_order_form" model="ir.ui.view">
        <field name="name">top.machinery.deployment.order.form</field>
        <field name="model">top.machinery.deployment.order</field>
        <field name="arch" type="xml">
            <form string="Machinery Deployment Order">
                <header>
                    <button name="action_approve" string="Approve Deployment" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_dispatch" string="Dispatch to Site" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_return_close" string="Return &amp; Close MDO" type="object" class="btn-success" invisible="state not in ('dispatched', 'in_progress')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state not in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,dispatched,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Deployment Order No."/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-secondary py-1 mb-3">
                        <i class="fa fa-info-circle me-1"/> <field name="fuel_rule_note"/>
                    </div>
                    <group>
                        <group string="Asset &amp; Site Allocation">
                            <field name="vehicle_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="project_site_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="is_individual_assignment" widget="boolean_toggle" readonly="state != 'draft'"/>
                            <field name="custodian_employee_id" invisible="not is_individual_assignment" readonly="state != 'draft'"/>
                            <field name="operator_id" invisible="is_individual_assignment" readonly="state != 'draft'"/>
                            <field name="assistant_id" invisible="is_individual_assignment" readonly="state != 'draft'"/>
                        </group>
                        <group string="Schedule &amp; Meter Readings">
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="meter_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="initial_meter_reading" readonly="state not in ('draft', 'approved')"/>
                            <field name="return_meter_reading" readonly="state not in ('dispatched', 'in_progress')"/>
                            <field name="total_operated_units" class="fw-bold fs-5 text-primary"/>
                        </group>
                    </group>
                    <group string="Scope of Work">
                        <field name="operating_task" placeholder="e.g. Bulk Earthwork Excavation - ROHA Site Phase 2" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page name="handovers" string="Digital Handovers &amp; Returns">
                            <field name="handover_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="handover_type" widget="badge"/>
                                    <field name="holder_id"/>
                                    <field name="handover_date"/>
                                    <field name="meter_reading"/>
                                    <field name="fuel_level"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="extensions" string="Period Extensions">
                            <field name="extension_ids">
                                <list editable="bottom">
                                    <field name="request_id"/>
                                    <field name="previous_return_date"/>
                                    <field name="extended_return_date"/>
                                    <field name="reason"/>
                                    <field name="approved_by_id"/>
                                    <field name="date_approved"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- MDO List View -->
    <record id="view_top_machinery_deployment_order_tree" model="ir.ui.view">
        <field name="name">top.machinery.deployment.order.list</field>
        <field name="model">top.machinery.deployment.order</field>
        <field name="arch" type="xml">
            <list string="Machinery Deployment Orders" create="true">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="project_site_id"/>
                <field name="operator_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_operated_units"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('approved', 'dispatched')" 
                       decoration-success="state in ('in_progress', 'completed')"/>
            </list>
        </field>
    </record>

    <!-- MDO Kanban View -->
    <record id="view_top_machinery_deployment_order_kanban" model="ir.ui.view">
        <field name="name">top.machinery.deployment.order.kanban</field>
        <field name="model">top.machinery.deployment.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="project_site_id"/>
                <field name="operator_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-primary"><field name="name"/></strong>
                                <field name="state" widget="badge" 
                                       decoration-info="state == 'draft'" 
                                       decoration-warning="state in ('approved', 'dispatched')" 
                                       decoration-success="state in ('in_progress', 'completed')"/>
                            </div>
                            <div class="fw-bold mb-1"><field name="vehicle_id"/></div>
                            <div class="small text-muted mb-1"><i class="fa fa-map-marker text-danger me-1"/> <field name="project_site_id"/></div>
                            <div class="small text-muted"><i class="fa fa-user me-1"/> <field name="operator_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- MDO Window Action -->
    <record id="action_top_machinery_deployment_order" model="ir.actions.act_window">
        <field name="name">Machinery Deployments (MDO)</field>
        <field name="res_model">top.machinery.deployment.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
